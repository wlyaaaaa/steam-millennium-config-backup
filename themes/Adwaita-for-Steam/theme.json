{
  "author": "tkashkin",
  "description": "A skin to make Steam look more like a native GNOME app",
  "inject": {
    "injectors/cssloader/base.css": [
      "desktop",
      "menu"
    ],
    "injectors/cssloader/main.css": [
      "desktop"
    ]
  },
  "manifest_version": 9,
  "name": "Adwaita",
  "patches": {
    "Accent color": {
      "components": [
        {
          "css_variable": "adw-system-accent",
          "default": "#3584e4",
          "name": "Custom accent color",
          "on": "Custom",
          "tabs": [
            "desktop",
            "menu"
          ],
          "type": "color-picker"
        }
      ],
      "type": "dropdown",
      "values": {
        "Blue": {
          "injectors/common/accent/blue.css": [
            "desktop",
            "menu"
          ]
        },
        "Custom": {},
        "Green": {
          "injectors/common/accent/green.css": [
            "desktop",
            "menu"
          ]
        },
        "Orange": {
          "injectors/common/accent/orange.css": [
            "desktop",
            "menu"
          ]
        },
        "Pink": {
          "injectors/common/accent/pink.css": [
            "desktop",
            "menu"
          ]
        },
        "Purple": {
          "injectors/common/accent/purple.css": [
            "desktop",
            "menu"
          ]
        },
        "Red": {
          "injectors/common/accent/red.css": [
            "desktop",
            "menu"
          ]
        },
        "Slate": {
          "injectors/common/accent/slate.css": [
            "desktop",
            "menu"
          ]
        },
        "Teal": {
          "injectors/common/accent/teal.css": [
            "desktop",
            "menu"
          ]
        },
        "Theme default": {},
        "Yellow": {
          "injectors/common/accent/yellow.css": [
            "desktop",
            "menu"
          ]
        }
      }
    },
    "Color scheme": {
      "type": "dropdown",
      "values": {
        "Dark": {
          "injectors/common/colorscheme/dark.css": [
            "desktop",
            "menu"
          ]
        },
        "Light": {
          "injectors/common/colorscheme/light.css": [
            "desktop",
            "menu"
          ]
        },
        "System": {}
      }
    },
    "Color theme": {
      "type": "dropdown",
      "values": {
        "Adwaita": {},
        "Adwaita Gray (pre-GNOME 48)": {
          "adwaita/colorthemes/adwaita-gray/adwaita-gray.css": [
            "desktop",
            "menu"
          ]
        },
