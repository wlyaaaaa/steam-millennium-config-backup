          "adwaita/colorthemes/tomorrow-night/tomorrow-night.css": [
            "desktop",
            "menu"
          ]
        },
        "VGUI2": {
          "adwaita/colorthemes/vgui2/vgui2.css": [
            "desktop",
            "menu"
          ]
        },
        "Vapor": {
          "adwaita/colorthemes/vapor/vapor.css": [
            "desktop",
            "menu"
          ]
        },
        "Yaru": {
          "adwaita/colorthemes/yaru/yaru.css": [
            "desktop",
            "menu"
          ]
        }
      }
    },
    "Font": {
      "type": "dropdown",
      "values": {
        "Adwaita": {
          "injectors/cssloader/fonts/adwaita.css": [
            "desktop",
            "menu"
          ]
        },
        "Cantarell": {
          "injectors/cssloader/fonts/cantarell.css": [
            "desktop",
            "menu"
          ]
        },
        "System": {
          "adwaita/fonts/system/system.css": [
            "desktop",
            "menu"
          ]
        }
      }
    },
    "Login QR code": {
      "type": "dropdown",
      "values": {
        "Hide": {
          "adwaita/extras/login/hide-qr.css": [
            "desktop"
          ]
        },
        "Show": {},
        "Show on Hover": {
          "adwaita/extras/login/hover-qr.css": [
            "desktop"
          ]
        }
      }
    },
    "Pointer cursor for clickable elements": {
      "type": "checkbox",
      "values": {
        "No": {},
        "Yes": {
          "adwaita/extras/general/cursor-pointer.css": [
            "desktop",
            "menu"
          ]
        }
      }
    },
    "Rounded corners - Does not affect window corners": {
      "type": "checkbox",
      "values": {
        "No": {
          "adwaita/extras/general/no-rounded-corners.css": [
            "desktop",
            "menu"
          ]
        },
        "Yes": {}
      }
    },
    "Show Library Sidebar on hover": {
      "type": "checkbox",
      "values": {
        "No": {},
        "Yes": {
          "adwaita/extras/library/sidebar-hover.css": [
            "desktop"
          ]
        }
      }
    },
    "Show URL on Store and Community pages": {
      "type": "checkbox",
      "values": {
        "No": {},
        "Yes": {
          "adwaita/extras/store/show-url.css": [
            "desktop"
          ]
        }
      }
    },
    "Show What's New shelf in Library": {
      "type": "checkbox",
      "values": {
        "No": {
          "adwaita/extras/library/hide-whats-new.css": [
            "desktop"
          ]
        },
        "Yes": {}
      }
    },
    "Square icons in game details": {
      "type": "checkbox",
      "values": {
        "No": {
          "adwaita/extras/library/uncrop-covers-in-details.css": [
            "desktop"
          ]
        },
        "Yes": {}
      }
    },
    "Window controls layout": {
      "type": "dropdown",
      "values": {
        "Adwaita": {
          "injectors/common/windowcontrols/adwaita.css": [
            "desktop"
          ]
        },
        "Pantheon": {
          "injectors/common/windowcontrols/pantheon.css": [
            "desktop"
          ]
        },
        "Windows": {
          "injectors/common/windowcontrols/windows.css": [
            "desktop"
          ]
        },
        "macOS": {
          "injectors/common/windowcontrols/macos.css": [
            "desktop"
          ]
        }
      }
    },
    "Window controls theme": {
      "type": "dropdown",
      "values": {
        "Adwaita (GNOME)": {
          "adwaita/windowcontrols/adwaita.css": [
            "desktop"
          ]
        },
        "Breeze (KDE)": {
          "adwaita/windowcontrols/breeze.css": [
            "desktop"
          ]
        },
        "Windows": {
          "adwaita/windowcontrols/windows.css": [
            "desktop"
          ]
        },
        "macOS": {
          "adwaita/windowcontrols/macos.css": [
            "desktop"
          ]
        }
      }
    }
  },
  "tabs": {
    "desktop": [
      "Steam|SteamLibraryWindow",
      "desktopchat",
      "desktopoverlay",
      "~&browser=-1&useragent=Valve%20Steam%20Client~"
    ],
    "menu": [
      "desktopcontextmenu"
    ]
  },
  "target": "Desktop",
  "version": "4.4"
}
