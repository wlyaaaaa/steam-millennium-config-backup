          ]
        },
        "Metro": {
          "adwaita/colorthemes/metro/metro.css": [
            "desktop",
            "menu"
          ]
        },
        "Nord": {
          "adwaita/colorthemes/nord/nord.css": [
            "desktop",
            "menu"
          ]
        },
        "OLED": {
          "adwaita/colorthemes/oled/oled.css": [
