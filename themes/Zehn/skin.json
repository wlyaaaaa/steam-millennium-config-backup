  "Patches": [
    {
      "MatchRegexString": "^Steam Big Picture Mode$",
      "TargetCss": "css/min.css",
      "TargetJs": "js/bigpicture.js"
    },
    {
      "MatchRegexString": "^QuickAccess_",
      "TargetCss": "css/min.css",
      "TargetJs": "js/bigpicture.js"
    },
    {
      "MatchRegexString": "^MainMenu_",
      "TargetCss": "css/min.css",
      "TargetJs": "js/bigpicture.js"
    },
    {
      "MatchRegexString": "broadcaststatus",
      "TargetCss": "css/full.css",
      "TargetJs": "js/broadcast.js"
    },
    {
      "MatchRegexString": ".l25AfossKXBOZGYoty0tM",
      "TargetCss": "css/full.css",
      "TargetJs": "js/controller.js"
    },
    {
      "MatchRegexString": ".SavedDimensionsPopup",
      "TargetCss": "css/full.css",
      "TargetJs": "js/friends.js"
    },
    {
      "MatchRegexString": ".ChatPopup",
      "TargetCss": "css/full.css",
      "TargetJs": "js/friends.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "css/full.css",
      "TargetJs": "js/library.js"
    },
    {
      "MatchRegexString": "/قائمة ألعاب Steam|Steam — Lista de jogos|Steam: spellenlijst|Liste der Steam-Spiele|Steam : liste de jeux|Steam-pelien lista|Lista jocurilor de pe Steam|Steam-spilliste|Steam – seznam her|Steam Games List|Danh sách trò chơi Steam|Списък със Steam игри|Λίστα παιχνιδιών Steam|Steam-spellista|Steam 游戏列表|Steam 게임 목록|Lista de juegos de Steam|Senarai Permainan Steam|Steam – liste over spill|Список игр в Steam|Steam: Lista de jogos|蒸汽平台游戏列表|รายชื่อเกมบน Steam|Lista de juegos de Steam|Cписок ігор у Steam|Steam 遊戲列表|Lista de juegos de Steam|Steam Oyun Listesi|Daftar Game Steam|Steamゲームリスト|Lista gier Steam|Steam játéklista|Elenco dei giochi di Steam/",
      "TargetCss": "css/full.css",
      "TargetJs": "js/library.js"
    },
    {
      "MatchRegexString": "/تسجيل الدخول إلى Steam|Iniciar a sessão no Steam|Вписване в Steam|Přihlášení do služby Steam|Log på Steam|Aanmelden bij Steam|Sign in to Steam|Kirjaudu Steamiin|Se connecter à Steam|Bei Steam anmelden|Σύνδεση στο Steam|Bejelentkezés a Steambe|Login ke Steam|Accedi a Steam|Steamにサインイン|Steam 로그인|Iniciar sesión en Steam|Daftar masuk ke Steam|Logg inn på Steam|Zaloguj się do Steam|Iniciar sessão no Steam|Conectează-te la Steam|Войти в Steam|登录蒸汽平台|登录 Steam|Iniciar sesión en Steam|Logga in på Steam|登入 Steam|เข้าสู่ระบบ Steam|Steam'e Giriş Yap|Увійти до Steam|Đăng nhập vào Steam/",
      "TargetCss": "css/full.css",
      "TargetJs": "js/login.js"
    },
    {
      "MatchRegexString": "._14wqdluDeDnnEcg3OSLEmd",
      "TargetCss": "css/full.css",
      "TargetJs": "js/menu.js"
    },
    {
      "MatchRegexString": ".HoverPopup",
      "TargetCss": "css/full.css",
      "TargetJs": "js/miniprofile.js"
    },
    {
      "MatchRegexString": "^notificationtoasts_",
      "TargetCss": "css/full.css",
      "TargetJs": "js/toast.js"
    },
    {
      "MatchRegexString": "^SP Overlay:",
      "TargetCss": "css/full.css",
      "TargetJs": "js/overlay.js"
    },
    {
      "MatchRegexString": ".ModalDialogBody",
      "TargetCss": "css/full.css",
      "TargetJs": "js/popup.js"
    },
    {
      "MatchRegexString": "^OverlayBrowser_.*_Find$",
      "TargetCss": "css/full.css",
      "TargetJs": "js/search.js"
    },
    {
      "MatchRegexString": "^SteamBrowser_Find$",
      "TargetCss": "css/full.css",
      "TargetJs": "js/search.js"
    },
    {
      "MatchRegexString": "^OverlayTab\\d+_Find$",
      "TargetCss": "css/full.css",
      "TargetJs": "js/search.js"
    },
    {
      "MatchRegexString": "https://.*.steampowered.com",
      "TargetCss": "css/web.css",
      "TargetJs": "js/web.js"
    },
    {
      "MatchRegexString": "https://steamcommunity.com",
      "TargetCss": "css/web.css",
      "TargetJs": "js/web.js"
    }
  ],
